{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentReviewReport",
  "description": "Retrospective analysis of one incident's own response record. Field semantics: references/report-format.md. Ported from ai-ir2's analysis models (ADR-009); the tactic object keeps ai-ir2's field set verbatim.",
  "type": "object",
  "required": [
    "incident_id",
    "review_date",
    "record_name",
    "message_count",
    "summary",
    "activity",
    "roles",
    "review",
    "tactics",
    "security_notes"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Deterministic 12-char id printed by preprocess.py"
    },
    "review_date": { "type": "string", "format": "date" },
    "record_name": {
      "type": "string",
      "description": "Channel or record name from the preprocessed header"
    },
    "message_count": { "type": "integer" },
    "summary": {
      "type": "object",
      "required": [
        "title",
        "severity",
        "affected_systems",
        "timeline",
        "root_cause",
        "resolution",
        "summary"
      ],
      "properties": {
        "title": { "type": "string" },
        "severity": {
          "type": ["string", "null"],
          "description": "As stated or clearly implied by the record; null when the record never establishes one"
        },
        "affected_systems": { "type": "array", "items": { "type": "string" } },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["timestamp", "actor", "event"],
            "properties": {
              "timestamp": { "type": "string" },
              "actor": { "type": "string" },
              "event": { "type": "string" }
            }
          }
        },
        "root_cause": { "type": "string" },
        "resolution": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["participants"],
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["user_name", "role_hint", "actions"],
            "properties": {
              "user_name": { "type": "string" },
              "role_hint": { "type": "string" },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["timestamp", "purpose", "method", "findings"],
                  "properties": {
                    "timestamp": { "type": "string" },
                    "purpose": { "type": "string" },
                    "method": { "type": "string" },
                    "findings": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "required": ["participants", "relationships"],
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["user_name", "inferred_role", "confidence", "evidence"],
            "properties": {
              "user_name": { "type": "string" },
              "inferred_role": { "type": "string" },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_user", "to_user", "relationship_type", "description"],
            "properties": {
              "from_user": { "type": "string" },
              "to_user": { "type": ["string", "null"] },
              "relationship_type": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "overall_score",
        "phases",
        "communication",
        "role_clarity",
        "tool_appropriateness",
        "strengths",
        "improvements",
        "checklist"
      ],
      "properties": {
        "overall_score": {
          "type": "string",
          "enum": ["excellent", "good", "adequate", "poor", "unknown"]
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "estimated_duration", "quality", "notes"],
            "properties": {
              "phase": { "type": "string" },
              "estimated_duration": { "type": "string" },
              "quality": {
                "type": "string",
                "enum": ["good", "adequate", "poor", "unknown"]
              },
              "notes": { "type": "string" }
            }
          }
        },
        "communication": {
          "type": "object",
          "required": ["overall", "delays_observed", "silos_observed"],
          "properties": {
            "overall": { "type": "string" },
            "delays_observed": { "type": "array", "items": { "type": "string" } },
            "silos_observed": { "type": "array", "items": { "type": "string" } }
          }
        },
        "role_clarity": {
          "type": "object",
          "required": ["ic_identified", "ic_name", "gaps", "overlaps"],
          "properties": {
            "ic_identified": { "type": "boolean" },
            "ic_name": { "type": ["string", "null"] },
            "gaps": { "type": "array", "items": { "type": "string" } },
            "overlaps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tool_appropriateness": { "type": "string" },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "improvements": { "type": "array", "items": { "type": "string" } },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "priority"],
            "properties": {
              "item": { "type": "string" },
              "priority": { "type": "string", "enum": ["high", "medium", "low"] }
            }
          }
        }
      }
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "purpose",
          "category",
          "tools",
          "procedure",
          "observations",
          "tags",
          "confidence",
          "evidence",
          "source",
          "created_at"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "category": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } },
          "procedure": { "type": "string" },
          "observations": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "confidence": {
            "type": "string",
            "enum": ["confirmed", "inferred", "suggested"]
          },
          "evidence": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["channel", "participants"],
            "properties": {
              "channel": { "type": "string" },
              "participants": { "type": "array", "items": { "type": "string" } }
            }
          },
          "created_at": { "type": "string", "format": "date" }
        }
      }
    },
    "security_notes": {
      "type": "object",
      "required": ["injection_flagged_messages", "warnings"],
      "properties": {
        "injection_flagged_messages": { "type": "integer" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
